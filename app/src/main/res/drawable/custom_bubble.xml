<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="100dp"
                android:startColor="#33FFFFFF"
                android:centerColor="#22AADDFF"
                android:endColor="#8855CCFF" />
            <stroke android:width="1dp" android:color="#AAFFFFFF"/>
        </shape>
    </item>
    <item android:top="10dp" android:left="15dp" android:right="35dp" android:bottom="45dp">
        <shape android:shape="oval">
            <solid android:color="#CCFFFFFF"/>
        </shape>
    </item>
</layer-list>