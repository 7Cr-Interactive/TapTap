<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌟 Dynamic 90s Kids Cartoon Scenery Environment -->
    <com.app.taptap.ui.cartoon.CartoonSceneryView
        android:id="@+id/sceneryBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/birdView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:visibility="gone"/>

    <!-- 🥶 Freeze Frost Screen Overlay -->
    <View
        android:id="@+id/freezeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2600E5FF"
        android:alpha="0"
        android:visibility="gone"/>

    <!-- ⚠️ Low Time Red Warning Overlay -->
    <View
        android:id="@+id/warningVignette"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33FF0000"
        android:alpha="0"
        android:visibility="gone"/>

    <!-- ✨ Floating particles -->
    <FrameLayout
        android:id="@+id/particleLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 🔥 HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/score_pill_bg"
                android:text="Score: 0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:padding="8dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <TextView
            android:id="@+id/powerUpStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#FFEB3B"
            android:textStyle="bold"
            android:textSize="14sp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/timeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:max="100"
            android:progress="100"
            android:layout_marginTop="10dp"/>
    </LinearLayout>

</FrameLayout>
